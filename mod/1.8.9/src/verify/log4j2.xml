<?xml version="1.0" encoding="UTF-8"?>
<!-- For the build's `verifyMixins` run only. The game's own configuration (inside the client jar)
     names an appender class that only exists on a full game classpath and logs two errors about
     it on every run - noise right above the check's result. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="SysOut" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level]: %msg%n" />
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="SysOut"/>
        </Root>
    </Loggers>
</Configuration>
