{
	"schemaVersion": 1,
	"id": "tntsallin1client",
	"version": "${version}",
	"name": "TNT's All-In-1 Client",
	"description": "Custom Minecraft: Java Edition client (Fabric mod half) — performance and quality-of-life features, paired with its own launcher.",
	"authors": [
		"clenz-debug"
	],
	"contact": {
		"sources": "https://github.com/clenz-debug/TNTsAllIn1Client"
	},
	"license": "GPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.tntsallin1client.TNTsAllIn1ClientMod"
		]
	},
	"accessWidener": "tntsallin1client.accesswidener",
	"mixins": [
		"tntsallin1client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"continuity": ">=3.0.0"
	},
	"custom": {
		"cape": {
			"url": "https://nxlc.de/tntcapes/§id.png"
		}
	}
}
