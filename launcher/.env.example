# Backblaze B2 — custom cape storage (see main/cape/). Copy to .env (gitignored) and fill in
# real values from your own B2 bucket + application key. Baked into the built app at build time
# (electron-vite's MAIN_VITE_ prefix) - .env must exist with real values on whichever machine runs
# `npm run build`/`npm run package:win`/`npm run release:win`, not just `npm run dev`.
MAIN_VITE_B2_KEY_ID=
MAIN_VITE_B2_APPLICATION_KEY=
MAIN_VITE_B2_BUCKET=
MAIN_VITE_B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
MAIN_VITE_B2_REGION=us-west-004
MAIN_VITE_B2_PUBLIC_BASE_URL=https://f004.backblazeb2.com/file/tnts-client-capes
